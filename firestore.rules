rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Web flashcard app. Bind does not need these cut.
    match /words/{wordId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !exists(/databases/$(database)/documents/words/$(wordId));
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false;

      match /progress/{wordId} {
        allow read, write: if isOwner(uid);
      }
      match /conversions/{id} {
        allow read, write: if isOwner(uid);
      }
      match /wordbook/{id} {
        allow read, write: if isOwner(uid);
      }
      match /practiceSessions/{id} {
        allow read, write: if isOwner(uid);
      }
    }

    match /dictCache/{id} {
      allow read, write: if false;
    }
  }
}
