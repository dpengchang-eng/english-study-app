# App Check debug token for Expo / local.
# Firebase AI Logic auto-enforces App Check. Register this token on the
# web app in Firebase Console → App Check → Manage debug tokens
# (project english-study-app-c645a).
# Then copy this file to .env and restart with: npx expo start -c
# Never commit the real token.
# Production Play Integrity / App Attest is not required for v1.
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=
