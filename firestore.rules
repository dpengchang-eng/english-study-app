rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Existing web flashcard app (do not tighten these documents):
    //
    // Collection: words/{wordId}
    // Fields: english, korean, example, level
    //
    // Collection: users/{userId}
    // Web stats fields stay owner-writable without a tight schema.
    //
    // Collection: users/{userId}/progress/{wordId}
    // Web review progress. Owner only.
    //
    // 地道 mobile:
    //
    // Collection: users/{userId}/conversions/{conversionId}
    //   - sourceText: string 1-500, immutable
    //   - sourceLang: zh | en | mixed
    //   - rewrittenText: string 1-4000
    //   - status: loading | ready | error
    //   - sentences: list <= 40 of { text, tokens[], audioStatus }
    //       tokens[] from the backend; audioStatus ready|pending|unavailable
    //   - createdAt: timestamp, immutable
    //   loading may have an empty sentences list.
    //
    // Collection: users/{userId}/wordbook/{itemId}
    //   - phrase, ipa, senses[<=3], sentenceContext, conversionId
    //   - blankStart, blankEnd (PracticeCard.blankSpan)
    //   - createdAt, dueAt, intervalDays, lastResult, reviewCount
    //   - syncState: synced | pending | error
    //
    // Collection: users/{userId}/settings/didao
    //   - quizSize 5|10|15, speechRate, cloudVoice
    //
    // Collection: users/{userId}/savedItems/{itemId}
    //   Legacy v1 collection. Owner may read/delete only.
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() >= minLen
        && request.resource.data[field].size() <= maxLen;
    }

    function isValidConversion(data) {
      return hasOnlyAllowedFields([
        'sourceText', 'sourceLang', 'rewrittenText', 'status', 'sentences', 'createdAt'
      ])
        && validStringLength('sourceText', 1, 500)
        && data.sourceLang in ['zh', 'en', 'mixed']
        && validStringLength('rewrittenText', 1, 4000)
        && data.status in ['loading', 'ready', 'error']
        && data.sentences is list
        && data.sentences.size() <= 40
        && (data.status == 'loading' || data.sentences.size() > 0)
        && data.createdAt is timestamp;
    }

    function conversionCoreUnchanged() {
      return request.resource.data.sourceText == resource.data.sourceText
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidWordbook(data) {
      return hasOnlyAllowedFields([
        'phrase', 'ipa', 'senses', 'sentenceContext', 'conversionId',
        'blankStart', 'blankEnd', 'createdAt', 'dueAt', 'intervalDays',
        'lastResult', 'reviewCount', 'syncState'
      ])
        && validStringLength('phrase', 1, 180)
        && data.ipa is string
        && data.ipa.size() <= 80
        && data.senses is list
        && data.senses.size() <= 3
        && validStringLength('sentenceContext', 1, 760)
        && validStringLength('conversionId', 1, 80)
        && data.blankStart is number
        && data.blankEnd is number
        && data.blankStart >= 0
        && data.blankEnd >= 0
        && data.blankEnd <= 760
        && data.createdAt is timestamp
        && data.dueAt is timestamp
        && data.intervalDays in [0, 1, 3, 7]
        && (data.lastResult == null || data.lastResult in ['again', '1', '3', '7'])
        && data.reviewCount is number
        && data.reviewCount >= 0
        && data.reviewCount <= 10000
        && data.syncState in ['synced', 'pending', 'error'];
    }

    function wordbookCoreUnchanged() {
      return request.resource.data.phrase == resource.data.phrase
        && request.resource.data.ipa == resource.data.ipa
        && request.resource.data.senses == resource.data.senses
        && request.resource.data.sentenceContext == resource.data.sentenceContext
        && request.resource.data.conversionId == resource.data.conversionId
        && request.resource.data.blankStart == resource.data.blankStart
        && request.resource.data.blankEnd == resource.data.blankEnd
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidSettings(data) {
      return hasOnlyAllowedFields(['quizSize', 'speechRate', 'cloudVoice'])
        && data.quizSize in [5, 10, 15]
        && data.speechRate in ['slow', 'normal', 'fast']
        && data.cloudVoice is bool;
    }

    match /words/{wordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && !exists(/databases/$(database)/documents/words/$(wordId));
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /progress/{wordId} {
        allow read, write: if isOwner(userId);
      }

      match /conversions/{conversionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidConversion(request.resource.data);
        allow update: if isOwner(userId)
          && isValidConversion(request.resource.data)
          && conversionCoreUnchanged();
        allow delete: if false;
      }

      match /wordbook/{itemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWordbook(request.resource.data);
        allow update: if isOwner(userId)
          && isValidWordbook(request.resource.data)
          && wordbookCoreUnchanged();
        allow delete: if isOwner(userId);
      }

      match /settings/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && docId == 'didao'
          && isValidSettings(request.resource.data);
        allow delete: if false;
      }

      match /savedItems/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if false;
      }
    }
  }
}
