rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Web flashcard app (keep working):
    //   words/{wordId}
    //   users/{userId} study fields: totalSessions, totalAnswers, ...
    //   users/{userId}/progress/{wordId}
    //
    // 地道 convert v1 (Spark, client-side Gemini — no Functions):
    //   users/{uid}
    //     createdAt, updatedAt, locale=zh-CN, timezone=Asia/Seoul
    //     quota.convertCountToday, quota.convertDayKey — client may write
    //   users/{uid}/conversions/{id} — owner create + read
    //     sourceText, outputText, sentences[{id,text,tokens?}], createdAt
    //
    // Isolated next-cut collections (not built in v1 UI):
    //   users/{uid}/wordbook/{id}
    //   users/{uid}/settings/didao
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() >= minLen
        && request.resource.data[field].size() <= maxLen;
    }

    function isValidWordbook(data) {
      return hasOnlyAllowedFields([
        'phrase', 'ipa', 'senses', 'sentenceContext', 'conversionId',
        'blankStart', 'blankEnd', 'createdAt', 'dueAt', 'intervalDays',
        'lastResult', 'reviewCount', 'syncState'
      ])
        && validStringLength('phrase', 1, 180)
        && data.ipa is string
        && data.ipa.size() <= 80
        && data.senses is list
        && data.senses.size() <= 3
        && validStringLength('sentenceContext', 1, 760)
        && validStringLength('conversionId', 1, 80)
        && data.blankStart is number
        && data.blankEnd is number
        && data.blankStart >= 0
        && data.blankEnd >= 0
        && data.blankEnd <= 760
        && data.createdAt is timestamp
        && data.dueAt is timestamp
        && data.intervalDays in [0, 1, 3, 7]
        && (data.lastResult == null || data.lastResult in ['again', '1', '3', '7'])
        && data.reviewCount is number
        && data.reviewCount >= 0
        && data.reviewCount <= 10000
        && data.syncState in ['synced', 'pending', 'error'];
    }

    function wordbookCoreUnchanged() {
      return request.resource.data.phrase == resource.data.phrase
        && request.resource.data.ipa == resource.data.ipa
        && request.resource.data.senses == resource.data.senses
        && request.resource.data.sentenceContext == resource.data.sentenceContext
        && request.resource.data.conversionId == resource.data.conversionId
        && request.resource.data.blankStart == resource.data.blankStart
        && request.resource.data.blankEnd == resource.data.blankEnd
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidAppSettings(data) {
      return hasOnlyAllowedFields(['quizSize', 'speechRate', 'cloudVoice'])
        && data.quizSize in [5, 10, 15]
        && data.speechRate in ['slow', 'normal', 'fast']
        && data.cloudVoice is bool;
    }

    function isValidConversion(data) {
      return data.sourceText is string
        && data.sourceText.size() >= 1
        && data.sourceText.size() <= 500
        && data.outputText is string
        && data.outputText.size() >= 1
        && data.outputText.size() <= 4000
        && data.sentences is list
        && data.sentences.size() >= 1
        && data.sentences.size() <= 40
        && data.createdAt is timestamp
        && data.status == 'ready';
    }

    match /words/{wordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && !exists(/databases/$(database)/documents/words/$(wordId));
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /progress/{wordId} {
        allow read, write: if isOwner(userId);
      }

      match /conversions/{conversionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidConversion(request.resource.data);
        allow update, delete: if false;
      }

      match /requests/{clientRequestId} {
        allow read, write: if false;
      }

      match /wordbook/{itemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWordbook(request.resource.data);
        allow update: if isOwner(userId)
          && isValidWordbook(request.resource.data)
          && wordbookCoreUnchanged();
        allow delete: if isOwner(userId);
      }

      match /settings/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && docId == 'didao'
          && isValidAppSettings(request.resource.data);
        allow delete: if false;
      }

      match /savedItems/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if false;
      }
    }
  }
}
