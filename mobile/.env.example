# App Check debug token for Expo / local (including Expo web).
# Registered on the web app as "didao expo web local".
# Override if you register a different token.
# Restart with: npx expo start -c
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=7e00267c-ef77-495b-a159-e04757f33a9c

# Preferred for live convert. Dedicated "Gemini Developer API key" (Gemini-only).
# Do not use the Firebase browser apiKey — Google blocks Gemini on that key.
# Never commit the real key.
EXPO_PUBLIC_GEMINI_API_KEY=

# Firebase Web client ID for 绑定 Google (Expo Go / expo-auth-session).
# Firebase Console → Authentication → Sign-in method → enable Google,
# then copy Web client ID. Never commit the real .env.
# Expo Go redirect is exp://<metro-host>/--/oauthredirect
# (not didao://, not the computer's localhost).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
