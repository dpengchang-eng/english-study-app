# Optional. Used only if Firebase AI Logic is not enabled on the project.
# Get a Gemini API key from Google AI Studio. Do not commit the real key.
EXPO_PUBLIC_GEMINI_API_KEY=

# Optional. Google Cloud Text-to-Speech API key for higher-quality American English.
# If empty, the app uses expo-speech (device voice, language en-US).
EXPO_PUBLIC_GOOGLE_TTS_KEY=

# Optional. Needed later to bind Google on 我的.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
