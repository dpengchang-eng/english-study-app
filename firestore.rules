rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Web flashcard app (keep working):
    //   words/{wordId}
    //   users/{userId} study fields: totalSessions, totalAnswers, ...
    //   users/{userId}/progress/{wordId}
    //
    // 地道 convert v1 (Functions-owned):
    //   users/{uid}
    //     createdAt, updatedAt, locale=zh-CN, timezone=Asia/Seoul
    //     settings.ttsRate, settings.ttsVoiceHint   — client may write these
    //     quota.convertCountToday, quota.convertDayKey — Functions only
    //     stats.conversionCount — Functions only
    //   users/{uid}/conversions/{id} — client read-only
    //     clientRequestId, sourceType, sourceLang, sourceText, status,
    //     errorCode, outputText, model, promptVersion=convert-v1,
    //     createdAt, completedAt, sentences[{id,index,text,tokens[]}]
    //     token = {id,index,surface,lemma,pos,isWord,charStart,charEnd}
    //   users/{uid}/requests/{clientRequestId} — Functions only, 24h TTL
    //
    // Isolated next-cut collections (client-writable, not convert v1):
    //   users/{uid}/wordbook/{id}  WordbookItem.dueAt + syncState + blankSpan
    //   users/{uid}/settings/didao quizSize / speechRate / cloudVoice
    //
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() >= minLen
        && request.resource.data[field].size() <= maxLen;
    }

    function quotaUnchanged() {
      return request.resource.data.get('quota', {}) == resource.data.get('quota', {});
    }

    function didaoStatsUnchanged() {
      return request.resource.data.get('stats', {}) == resource.data.get('stats', {});
    }

    function clientCreateHasNoFunctionsFields() {
      return !request.resource.data.keys().hasAny(['quota', 'stats']);
    }

    function isValidWordbook(data) {
      return hasOnlyAllowedFields([
        'phrase', 'ipa', 'senses', 'sentenceContext', 'conversionId',
        'blankStart', 'blankEnd', 'createdAt', 'dueAt', 'intervalDays',
        'lastResult', 'reviewCount', 'syncState'
      ])
        && validStringLength('phrase', 1, 180)
        && data.ipa is string
        && data.ipa.size() <= 80
        && data.senses is list
        && data.senses.size() <= 3
        && validStringLength('sentenceContext', 1, 760)
        && validStringLength('conversionId', 1, 80)
        && data.blankStart is number
        && data.blankEnd is number
        && data.blankStart >= 0
        && data.blankEnd >= 0
        && data.blankEnd <= 760
        && data.createdAt is timestamp
        && data.dueAt is timestamp
        && data.intervalDays in [0, 1, 3, 7]
        && (data.lastResult == null || data.lastResult in ['again', '1', '3', '7'])
        && data.reviewCount is number
        && data.reviewCount >= 0
        && data.reviewCount <= 10000
        && data.syncState in ['synced', 'pending', 'error'];
    }

    function wordbookCoreUnchanged() {
      return request.resource.data.phrase == resource.data.phrase
        && request.resource.data.ipa == resource.data.ipa
        && request.resource.data.senses == resource.data.senses
        && request.resource.data.sentenceContext == resource.data.sentenceContext
        && request.resource.data.conversionId == resource.data.conversionId
        && request.resource.data.blankStart == resource.data.blankStart
        && request.resource.data.blankEnd == resource.data.blankEnd
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidAppSettings(data) {
      return hasOnlyAllowedFields(['quizSize', 'speechRate', 'cloudVoice'])
        && data.quizSize in [5, 10, 15]
        && data.speechRate in ['slow', 'normal', 'fast']
        && data.cloudVoice is bool;
    }

    match /words/{wordId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && !exists(/databases/$(database)/documents/words/$(wordId));
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && clientCreateHasNoFunctionsFields();
      allow update: if isOwner(userId) && quotaUnchanged() && didaoStatsUnchanged();
      allow delete: if false;

      match /progress/{wordId} {
        allow read, write: if isOwner(userId);
      }

      match /conversions/{conversionId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }

      match /requests/{clientRequestId} {
        allow read, write: if false;
      }

      match /wordbook/{itemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWordbook(request.resource.data);
        allow update: if isOwner(userId)
          && isValidWordbook(request.resource.data)
          && wordbookCoreUnchanged();
        allow delete: if isOwner(userId);
      }

      match /settings/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && docId == 'didao'
          && isValidAppSettings(request.resource.data);
        allow delete: if false;
      }

      match /savedItems/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if false;
      }
    }
  }
}
