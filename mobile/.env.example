# App Check debug token for Expo / local (including Expo web).
# Registered on the web app as "didao expo web local".
# Override if you register a different token.
# Restart with: npx expo start -c
EXPO_PUBLIC_APPCHECK_DEBUG_TOKEN=7e00267c-ef77-495b-a159-e04757f33a9c

# Fallback only, if Firebase AI Logic fails.
# Use the project's dedicated "Gemini Developer API key" (Gemini-only).
# Do not use the Firebase browser apiKey here — Google blocks Gemini on that key.
# Never commit the real key.
EXPO_PUBLIC_GEMINI_API_KEY=
